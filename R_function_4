#' Advance shallow water model by one time step using parallel processing
#'
#' This function orchestrates the time stepping for the shallow water simulation
#' by updating all active grid cells with \code{grid_cell_type == 1} in parallel
#' or serial mode. It handles the distribution of computational work across
#' multiple cores and manages the integration of updated states back into the
#' main state table.
#'
#' @param state_tbl Tibble containing current model state with columns:
#'   \describe{
#'     \item{grid_cell_id}{Unique grid cell identifier}
#'     \item{water_depth}{Water depth, unit m}
#'     \item{velocity_x}{x-direction velocity, unit m/min}
#'     \item{velocity_y}{y-direction velocity, unit m/min}
#'     \item{dem}{Ground elevation, unit m}
#'     \item{drainage}{Grid drainage capacity}
#'     \item{grid_cell_type}{Grid cell type; only \code{grid_cell_type == 1}
#'       cells are updated}
#'     \item{r}{Rainfall rate, unit m/min, optional}
#'     \item{i}{Infiltration rate, unit m/min, optional}
#'   }
#' @param neigh_tbl Tibble with neighbor relationships generated by
#'   \code{find_neighbors()}, containing columns:
#'   \code{grid_cell_id}, \code{a}, \code{b}, \code{c}, \code{d}, \code{e},
#'   \code{p}, \code{q}, \code{m}, \code{n}.
#' @param dx Numeric. Grid cell size in x-direction, unit m.
#' @param dy Numeric. Grid cell size in y-direction, unit m.
#' @param dt Numeric. Time step size, unit min.
#' @param g Numeric. Gravitational acceleration.
#' @param n Numeric. Manning's roughness coefficient.
#' @param h_min Numeric. Minimum water depth threshold, unit m.
#' @param parallel Logical. Whether to use parallel processing. Default is TRUE.
#' @param n_cores Integer. Number of CPU cores to use for parallel computation.
#'
#' @return Tibble with the same structure as input \code{state_tbl}, but with
#'   updated \code{water_depth}, \code{velocity_x}, and \code{velocity_y} values
#'   for all \code{grid_cell_type == 1} cells. Boundary cells
#'   with \code{grid_cell_type != 1} remain unchanged.
#'
#' @details The function implements a complete time stepping procedure:
#'
#'   \strong{Cell Selection:} Identifies all active cells
#'   with \code{grid_cell_type == 1} that require updates while leaving boundary
#'   cells unchanged.
#'
#'   \strong{Parallel Processing:} Uses a PSOCK cluster on Windows systems to
#'   distribute computational work. Each worker process gets a copy of the
#'   required data and executes \code{update_cell()} independently. Includes
#'   error handling and cluster testing to ensure reliability.
#'
#'   \strong{Error Handling:} Individual cell update failures are caught and
#'   logged as warnings, with the cell retaining its previous state to maintain
#'   simulation stability.
#'
#'   \strong{State Integration:} Updated cell states are merged back into the
#'   main state table using join operations, preserving the original table
#'   structure and non-updated cells.
#'
#' @section Performance Considerations:
#' Parallel processing overhead may not be beneficial for small grids
#' with fewer than about 1000 active cells. The function includes cluster
#' initialization and cleanup costs that can outweigh benefits for small
#' problems. Consider setting \code{parallel = FALSE} for small domains.
#'
#' @section Cluster Requirements:
#' When \code{parallel = TRUE}, the function requires:
#' \itemize{
#'   \item Available packages: dplyr, tibble on all worker nodes
#'   \item Sufficient memory to replicate \code{state_tbl} and \code{neigh_tbl}
#'     on each worker
#'   \item \code{update_cell()} function must be available in the package namespace
#' }
#'
#' @examples
#' \dontrun{
#' # Serial execution for small problems
#' new_state <- step_model(
#'   state_tbl = current_state,
#'   neigh_tbl = neighbors,
#'   dx = 90, dy = 90, dt = 1,
#'   parallel = FALSE
#' )
#'
#' # Parallel execution with 4 cores
#' new_state <- step_model(
#'   state_tbl = current_state,
#'   neigh_tbl = neighbors,
#'   dx = 90, dy = 90, dt = 1,
#'   parallel = TRUE,
#'   n_cores = 4
#' )
#' }
#'
#' @seealso
#' \code{\link{update_cell}} for single cell updates,
#' \code{\link{find_neighbors}} for neighbor table generation,
#' \code{\link[parallel]{makeCluster}} for parallel processing setup
#'
#' @export

step_model <- function(state_tbl, neigh_tbl, dx, dy, dt, g, n, h_min,
                       parallel = TRUE, n_cores = parallel::detectCores() - 1) {

  active_ids <- state_tbl$grid_cell_id[state_tbl$grid_cell_type == 1]

  if (parallel) {
    cl <- makeCluster(n_cores, type = "PSOCK")
    on.exit(stopCluster(cl))

    clusterEvalQ(cl, {
      library(cq2d)
      library(dplyr)
      library(tibble)
    })

    clusterExport(cl, varlist = c("state_tbl", "neigh_tbl", "dx", "dy",
                                  "dt", "g", "n", "h_min", "update_cell"),
                  envir = environment())

    updates <- parLapply(cl, active_ids, function(cid) {
      tryCatch({
        update_cell(cid, state_tbl, neigh_tbl,
                    dx = dx, dy = dy, dt = dt,
                    g = g, n = n, h_min = h_min)
      }, error = function(e) {
        # 返回错误信息和原始状态
        warning(paste("Error in cell", cid, ":", e$message))
        return(state_tbl[
          state_tbl$grid_cell_id == cid,
          c("grid_cell_id", "water_depth", "velocity_x", "velocity_y")
        ])
      })
    })
  } else {
    # 串行计算
    updates <- lapply(active_ids, function(cid) {
      update_cell(cid, state_tbl, neigh_tbl,
                  dx = dx, dy = dy, dt = dt,
                  g = g, n = n, h_min = h_min)
    })
  }

  updated_tbl <- bind_rows(updates)
  state_tbl <- state_tbl %>%
    dplyr::left_join(updated_tbl, by = "grid_cell_id", suffix = c("", ".new")) %>%
    dplyr::mutate(
      water_depth = ifelse(!is.na(water_depth.new), water_depth.new, water_depth),
      velocity_x = ifelse(!is.na(velocity_x.new), velocity_x.new, velocity_x),
      velocity_y = ifelse(!is.na(velocity_y.new), velocity_y.new, velocity_y)
    ) %>%
    dplyr::select(-water_depth.new, -velocity_x.new, -velocity_y.new)

  return(state_tbl)
}
