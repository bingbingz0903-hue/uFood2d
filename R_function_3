#' Update shallow water equations for a single grid cell using finite volume method
#'
#' This function implements a complete shallow water solver for a single
#' \code{grid_cell_type == 1} grid cell, including MUSCL surface reconstruction,
#' HLLC Riemann solver, bed slope source terms, and Manning friction.
#' The implementation follows a finite volume approach with operator splitting
#' for source terms.
#'
#' @param id Integer. The grid cell ID to update. The corresponding cell in
#'   \code{state_tbl} must have \code{grid_cell_type == 1}.
#' @param state_tbl Tibble or data frame containing current model state with
#'   required columns:
#'   \describe{
#'     \item{grid_cell_id}{Unique grid cell identifier}
#'     \item{water_depth}{Water depth, unit m}
#'     \item{velocity_x}{x-direction velocity, unit m/min}
#'     \item{velocity_y}{y-direction velocity, unit m/min}
#'     \item{dem}{Ground elevation, unit m}
#'     \item{drainage}{Grid drainage capacity}
#'     \item{grid_cell_type}{Grid cell type; only \code{grid_cell_type == 1}
#'       cells are updated}
#'     \item{r}{Rainfall rate, unit m/min, optional}
#'     \item{i}{Infiltration rate, unit m/min, optional}
#'   }
#' @param neigh_tbl Tibble with neighbor relationships generated by
#'   \code{find_neighbors()}, containing columns:
#'   \code{grid_cell_id}, \code{a}, \code{b}, \code{c}, \code{d}, \code{e},
#'   \code{p}, \code{q}, \code{m}, \code{n}.
#' @param dx Numeric. Grid cell size in x-direction.
#' @param dy Numeric. Grid cell size in y-direction.
#' @param dt Numeric. Time step size, unit min.
#' @param g Numeric. Gravitational acceleration.
#' @param n Numeric. Manning's roughness coefficient.
#' @param h_min Numeric. Minimum water depth threshold, unit m.
#'
#' @return A tibble with updated state containing columns:
#'   \itemize{
#'     \item{\code{grid_cell_id}}{Grid cell identifier}
#'     \item{\code{water_depth}}{Updated water depth}
#'     \item{\code{velocity_x}}{Updated x-direction velocity}
#'     \item{\code{velocity_y}}{Updated y-direction velocity}
#'   }
#'   Temporary columns \code{r} and \code{i} are removed from the output.
#'
#' @details The function implements a finite volume shallow water solver:
#'
#'   \strong{Surface Reconstruction:} Uses MUSCL approach to reconstruct water
#'   surface elevations at cell interfaces, accounting for bed topography
#'   variations using slope limiting to maintain numerical stability.
#'
#'   \strong{Flux Calculation:} Employs the HLLC
#'   (Harten-Lax-van Leer-Contact) Riemann solver to compute numerical fluxes
#'   across all four cell interfaces. The solver handles subcritical,
#'   supercritical, and transcritical flow conditions.
#'
#'   \strong{Source Terms:} Discretizes bed slope source terms using a
#'   well-balanced approach that maintains the C-property, i.e. lake-at-rest
#'   equilibrium. Manning friction is treated implicitly to improve numerical
#'   stability.
#'
#'   \strong{Boundary Conditions:} Non-\code{grid_cell_type == 1} cells are
#'   treated as boundary cells. Missing neighbors are handled by the existing
#'   neighbor table structure.
#'
#'   \strong{Numerical Stability:} Includes slope limiting, positivity
#'   preservation, and implicit friction treatment to maintain stable
#'   computations across a wide range of flow conditions.
#'
#' @section Algorithm Steps:
#' \enumerate{
#'   \item Extract target cell and neighbor states
#'   \item Perform MUSCL surface reconstruction at interfaces
#'   \item Compute HLLC fluxes for mass and momentum
#'   \item Calculate bed slope source terms with well-balanced discretization
#'   \item Apply Manning friction using implicit time integration
#'   \item Update conserved variables and derive primitive variables
#'   \item Enforce minimum water depth constraint and zero velocity for dry cells
#' }
#'
#' @note This function only updates cells with \code{grid_cell_type == 1}.
#'   Cells with other types are returned unchanged. The function assumes a
#'   structured Cartesian grid with uniform spacing \code{dx} and \code{dy}.
#'
#' @examples
#' \dontrun{
#' # Assuming prepared state and neighbor tables
#' updated_cell <- update_cell(
#'   id = 123,
#'   state_tbl = current_state,
#'   neigh_tbl = neighbor_table,
#'   dx = 90, dy = 90, dt = 1,
#'   g = 9.81, n = 0.025, h_min = 1e-10
#' )
#' }
#'
#' @seealso
#' \code{\link{find_neighbors}} for neighbor table generation,
#' \code{\link{prepare_initial_state}} for state table preparation
#'
#' @export
update_cell <- function(id, state_tbl, neigh_tbl, dx, dy, dt, g, n, h_min) {
  a <- state_tbl[state_tbl$grid_cell_id == id, ]
  if (a$grid_cell_type != 1) return(a)

  # 邻居
  neighs <- neigh_tbl[neigh_tbl$grid_cell_id == id, ]
  b <- state_tbl[state_tbl$grid_cell_id == neighs$b, ]  # 右
  d <- state_tbl[state_tbl$grid_cell_id == neighs$d, ]  # 左
  e <- state_tbl[state_tbl$grid_cell_id == neighs$e, ]  # 上
  c <- state_tbl[state_tbl$grid_cell_id == neighs$c, ]  # 下
  p <- state_tbl[state_tbl$grid_cell_id == neighs$p, ]  # b 右侧
  m <- state_tbl[state_tbl$grid_cell_id == neighs$m, ]  # d 左侧
  ncell <- state_tbl[state_tbl$grid_cell_id == neighs$n, ]  # e 上侧
  q <- state_tbl[state_tbl$grid_cell_id == neighs$q, ]  # c 下侧

  # ============ 表面重构法 ============
  xfa <- a; xfb <- b; xfd <- d; xfe <- e; xfc <- c
  xfp <- p; xfm <- m; xfn <- ncell; xfq <- q

  # --- 右界面 ---
  br <- xfb$dem - 0.5 * (xfp$dem - xfb$dem) *
    max(0, min(ifelse(is.na((xfp$dem - xfb$dem) / (xfb$dem - xfa$dem)) |
                        is.infinite((xfp$dem - xfb$dem) / (xfb$dem - xfa$dem)),
                      0, (xfp$dem - xfb$dem) / (xfb$dem - xfa$dem)), 1))
  al <- xfa$dem + 0.5 * (xfb$dem - xfa$dem) *
    max(0, min(ifelse(is.na((xfb$dem - xfa$dem) / (xfa$dem - xfd$dem)) |
                        is.infinite((xfb$dem - xfa$dem) / (xfa$dem - xfd$dem)),
                      0, (xfb$dem - xfa$dem) / (xfa$dem - xfd$dem)), 1))
  ddem_x1 <- br - al
  nl_x1 <- xfa$dem + xfa$water_depth +
    max(0, min(xfb$dem - xfa$dem - ddem_x1,
               xfb$dem + xfb$water_depth - xfa$dem - xfa$water_depth))
  nr_x1 <- xfb$dem + xfb$water_depth +
    max(0, min(xfa$dem - xfb$dem + ddem_x1,
               xfa$dem + xfa$water_depth - xfb$dem - xfb$water_depth))
  gl_x1 <- nl_x1 - xfa$water_depth
  gr_x1 <- nr_x1 - xfb$water_depth
  gf_x1 <- max(gl_x1, gr_x1)
  ahl <- max(0, nl_x1 - gf_x1)
  bhr <- max(0, nr_x1 - gf_x1)

  # --- 左界面 ---
  ar <- xfa$dem - 0.5 * (xfb$dem - xfa$dem) *
    max(0, min(ifelse(is.na((xfb$dem - xfa$dem) / (xfa$dem - xfd$dem)) |
                        is.infinite((xfb$dem - xfa$dem) / (xfa$dem - xfd$dem)),
                      0, (xfb$dem - xfa$dem) / (xfa$dem - xfd$dem)), 1))
  dl <- xfd$dem + 0.5 * (xfa$dem - xfd$dem) *
    max(0, min(ifelse(is.na((xfa$dem - xfd$dem) / (xfd$dem - xfm$dem)) |
                        is.infinite((xfa$dem - xfd$dem) / (xfd$dem - xfm$dem)),
                      0, (xfa$dem - xfd$dem) / (xfd$dem - xfm$dem)), 1))
  ddem_x2 <- ar - dl
  nl_x2 <- xfd$dem + xfd$water_depth +
    max(0, min(xfa$dem - xfd$dem - ddem_x2,
               xfa$dem + xfa$water_depth - xfd$dem - xfd$water_depth))
  nr_x2 <- xfa$dem + xfa$water_depth +
    max(0, min(xfd$dem - xfa$dem + ddem_x2,
               xfd$dem + xfd$water_depth - xfa$dem - xfa$water_depth))
  gl_x2 <- nl_x2 - xfd$water_depth
  gr_x2 <- nr_x2 - xfa$water_depth
  gf_x2 <- max(gl_x2, gr_x2)
  dhl <- max(0, nl_x2 - gf_x2)  # 左邻水深
  ahr <- max(0, nr_x2 - gf_x2)  # 当前单元左界面水深

  # --- 上界面 ---
  ed <- xfe$dem - 0.5 * (xfn$dem - xfe$dem) *
    max(0, min(ifelse(is.na((xfn$dem - xfe$dem) / (xfe$dem - xfa$dem)) |
                        is.infinite((xfn$dem - xfe$dem) / (xfe$dem - xfa$dem)),
                      0, (xfn$dem - xfe$dem) / (xfe$dem - xfa$dem)), 1))
  at <- xfa$dem + 0.5 * (xfe$dem - xfa$dem) *
    max(0, min(ifelse(is.na((xfe$dem - xfa$dem) / (xfa$dem - xfc$dem)) |
                        is.infinite((xfe$dem - xfa$dem) / (xfa$dem - xfc$dem)),
                      0, (xfe$dem - xfa$dem) / (xfa$dem - xfc$dem)), 1))
  ddem_y1 <- ed - at
  nt_y1 <- xfa$dem + xfa$water_depth +
    max(0, min(xfe$dem - xfa$dem - ddem_y1,
               xfe$dem + xfe$water_depth - xfa$dem - xfa$water_depth))
  nd_y1 <- xfe$dem + xfe$water_depth +
    max(0, min(xfa$dem - xfe$dem + ddem_y1,
               xfa$dem + xfa$water_depth - xfe$dem - xfe$water_depth))
  gt_y1 <- nt_y1 - xfa$water_depth
  gd_y1 <- nd_y1 - xfe$water_depth
  gf_y1 <- max(gt_y1, gd_y1)
  aht <- max(0, nt_y1 - gf_y1)  # 上界水深
  ehd <- max(0, nd_y1 - gf_y1)  # 上邻水深

  # --- 下界面 ---
  ad <- xfa$dem - 0.5 * (xfe$dem - xfa$dem) *
    max(0, min(ifelse(is.na((xfe$dem - xfa$dem) / (xfa$dem - xfc$dem)) |
                        is.infinite((xfe$dem - xfa$dem) / (xfa$dem - xfc$dem)),
                      0, (xfe$dem - xfa$dem) / (xfa$dem - xfc$dem)), 1))
  ct <- xfc$dem + 0.5 * (xfa$dem - xfc$dem) *
    max(0, min(ifelse(is.na((xfa$dem - xfc$dem) / (xfc$dem - xfq$dem)) |
                        is.infinite((xfa$dem - xfc$dem) / (xfc$dem - xfq$dem)),
                      0, (xfa$dem - xfc$dem) / (xfc$dem - xfq$dem)), 1))
  ddem_y2 <- ad - ct
  nt_y2 <- xfc$dem + xfc$water_depth +
    max(0, min(xfa$dem - xfc$dem - ddem_y2,
               xfa$dem + xfa$water_depth - xfc$dem - xfc$water_depth))
  nd_y2 <- xfa$dem + xfa$water_depth +
    max(0, min(xfc$dem - xfa$dem + ddem_y2,
               xfc$dem + xfc$water_depth - xfa$dem - xfa$water_depth))
  gt_y2 <- nt_y2 - xfc$water_depth
  gd_y2 <- nd_y2 - xfa$water_depth
  gf_y2 <- max(gt_y2, gd_y2)
  cht <- max(0, nt_y2 - gf_y2)
  ahd <- max(0, nd_y2 - gf_y2)

  # ============ 2. HLLC 通量更新 ============
  # --- 右边界 ---
  sl_x1 <- min(a$velocity_x - sqrt(g * ahl), b$velocity_x - sqrt(g * bhr))
  sr_x1 <- max(a$velocity_x + sqrt(g * ahl), b$velocity_x + sqrt(g * bhr))
  slr_x1 <- ifelse(
    is.na((bhr * b$velocity_x * (sr_x1 - b$velocity_x) -
             ahl * a$velocity_x * (sl_x1 - a$velocity_x) +
             0.5 * g * (ahl^2 - bhr^2)) /
            (bhr * (sr_x1 - b$velocity_x) -
               ahl * (sl_x1 - a$velocity_x))) |
      is.infinite((bhr * b$velocity_x * (sr_x1 - b$velocity_x) -
                     ahl * a$velocity_x * (sl_x1 - a$velocity_x) +
                     0.5 * g * (ahl^2 - bhr^2)) /
                    (bhr * (sr_x1 - b$velocity_x) -
                       ahl * (sl_x1 - a$velocity_x))),
    0,
    (bhr * b$velocity_x * (sr_x1 - b$velocity_x) -
       ahl * a$velocity_x * (sl_x1 - a$velocity_x) +
       0.5 * g * (ahl^2 - bhr^2)) /
      (bhr * (sr_x1 - b$velocity_x) -
         ahl * (sl_x1 - a$velocity_x))
  )

  if (sl_x1 >= 0) {
    Fx1  <- a$velocity_x * ahl
    Gfx1 <- ahl * a$velocity_x^2 + 0.5 * g * ahl^2 +
      ahl * a$velocity_x * a$velocity_y
  } else if (sr_x1 <= 0) {
    Fx1  <- b$velocity_x * bhr
    Gfx1 <- bhr * b$velocity_x^2 + 0.5 * g * bhr^2 +
      bhr * b$velocity_x * b$velocity_y
  } else if (sl_x1 <= 0 && slr_x1 >= 0) {
    Fx1  <- a$velocity_x * ahl +
      sl_x1 * (ahl * (sl_x1 - a$velocity_x) / (sl_x1 - slr_x1) - ahl)
    Gfx1 <- ahl * a$velocity_x^2 + 0.5 * g * ahl^2 +
      ahl * a$velocity_x * a$velocity_y +
      sl_x1 * (
        ahl * (sl_x1 - a$velocity_x) / (sl_x1 - slr_x1) * slr_x1 +
          ahl * (sl_x1 - a$velocity_x) / (sl_x1 - slr_x1) * a$velocity_y -
          ahl * a$velocity_x - ahl * a$velocity_y
      )
  } else {
    Fx1  <- b$velocity_x * bhr +
      sr_x1 * (bhr * (sr_x1 - b$velocity_x) / (sr_x1 - slr_x1) - bhr)
    Gfx1 <- bhr * b$velocity_x^2 + 0.5 * g * bhr^2 +
      bhr * b$velocity_x * b$velocity_y +
      sr_x1 * (
        bhr * (sr_x1 - b$velocity_x) / (sr_x1 - slr_x1) * slr_x1 +
          bhr * (sr_x1 - b$velocity_x) / (sr_x1 - slr_x1) * b$velocity_y -
          bhr * b$velocity_x - bhr * b$velocity_y
      )
  }

  # --- 左边界 ---
  sl_x2 <- min(d$velocity_x - sqrt(g * dhl), a$velocity_x - sqrt(g * ahr))
  sr_x2 <- max(d$velocity_x + sqrt(g * dhl), a$velocity_x + sqrt(g * ahr))
  slr_x2 <- ifelse(
    is.na((ahr * a$velocity_x * (sr_x2 - a$velocity_x) -
             dhl * d$velocity_x * (sl_x2 - d$velocity_x) +
             0.5 * g * (dhl^2 - ahr^2)) /
            (ahr * (sr_x2 - a$velocity_x) -
               dhl * (sl_x2 - d$velocity_x))) |
      is.infinite((ahr * a$velocity_x * (sr_x2 - a$velocity_x) -
                     dhl * d$velocity_x * (sl_x2 - d$velocity_x) +
                     0.5 * g * (dhl^2 - ahr^2)) /
                    (ahr * (sr_x2 - a$velocity_x) -
                       dhl * (sl_x2 - d$velocity_x))),
    0,
    (ahr * a$velocity_x * (sr_x2 - a$velocity_x) -
       dhl * d$velocity_x * (sl_x2 - d$velocity_x) +
       0.5 * g * (dhl^2 - ahr^2)) /
      (ahr * (sr_x2 - a$velocity_x) -
         dhl * (sl_x2 - d$velocity_x))
  )

  if (sl_x2 >= 0) {
    Fx2  <- d$velocity_x * dhl
    Gfx2 <- dhl * d$velocity_x^2 + 0.5 * g * dhl^2 +
      dhl * d$velocity_x * d$velocity_y
  } else if (sr_x2 <= 0) {
    Fx2  <- a$velocity_x * ahr
    Gfx2 <- ahr * a$velocity_x^2 + 0.5 * g * ahr^2 +
      ahr * a$velocity_x * a$velocity_y
  } else if (sl_x2 <= 0 && slr_x2 >= 0) {
    Fx2  <- d$velocity_x * dhl +
      sl_x2 * (dhl * (sl_x2 - d$velocity_x) / (sl_x2 - slr_x2) - dhl)
    Gfx2 <- dhl * d$velocity_x^2 + 0.5 * g * dhl^2 +
      dhl * d$velocity_x * d$velocity_y +
      sl_x2 * (
        dhl * (sl_x2 - d$velocity_x) / (sl_x2 - slr_x2) * slr_x2 +
          dhl * (sl_x2 - d$velocity_x) / (sl_x2 - slr_x2) * d$velocity_y -
          dhl * d$velocity_x - dhl * d$velocity_y
      )
  } else {
    Fx2  <- a$velocity_x * ahr +
      sr_x2 * (ahr * (sr_x2 - a$velocity_x) / (sr_x2 - slr_x2) - ahr)
    Gfx2 <- ahr * a$velocity_x^2 + 0.5 * g * ahr^2 +
      ahr * a$velocity_x * a$velocity_y +
      sr_x2 * (
        ahr * (sr_x2 - a$velocity_x) / (sr_x2 - slr_x2) * slr_x2 +
          ahr * (sr_x2 - a$velocity_x) / (sr_x2 - slr_x2) * a$velocity_y -
          ahr * a$velocity_x - ahr * a$velocity_y
      )
  }

  # --- 上边界 ---
  sl_y1 <- min(a$velocity_y - sqrt(g * aht), e$velocity_y - sqrt(g * ehd))
  sr_y1 <- max(a$velocity_y + sqrt(g * aht), e$velocity_y + sqrt(g * ehd))
  slr_y1 <- ifelse(
    is.na((ehd * e$velocity_y * (sr_y1 - e$velocity_y) -
             aht * a$velocity_y * (sl_y1 - a$velocity_y) +
             0.5 * g * (aht^2 - ehd^2)) /
            (ehd * (sr_y1 - e$velocity_y) -
               aht * (sl_y1 - a$velocity_y))) |
      is.infinite((ehd * e$velocity_y * (sr_y1 - e$velocity_y) -
                     aht * a$velocity_y * (sl_y1 - a$velocity_y) +
                     0.5 * g * (aht^2 - ehd^2)) /
                    (ehd * (sr_y1 - e$velocity_y) -
                       aht * (sl_y1 - a$velocity_y))),
    0,
    (ehd * e$velocity_y * (sr_y1 - e$velocity_y) -
       aht * a$velocity_y * (sl_y1 - a$velocity_y) +
       0.5 * g * (aht^2 - ehd^2)) /
      (ehd * (sr_y1 - e$velocity_y) -
         aht * (sl_y1 - a$velocity_y))
  )

  if (sl_y1 >= 0) {
    Fy1  <- a$velocity_y * aht
    Gfy1 <- aht * a$velocity_y^2 + 0.5 * g * aht^2 +
      aht * a$velocity_x * a$velocity_y
  } else if (sr_y1 <= 0) {
    Fy1  <- e$velocity_y * ehd
    Gfy1 <- ehd * e$velocity_y^2 + 0.5 * g * ehd^2 +
      ehd * e$velocity_x * e$velocity_y
  } else if (sl_y1 <= 0 && slr_y1 >= 0) {
    Fy1  <- a$velocity_y * aht +
      sl_y1 * (aht * (sl_y1 - a$velocity_y) / (sl_y1 - slr_y1) - aht)
    Gfy1 <- aht * a$velocity_y^2 + 0.5 * g * aht^2 +
      aht * a$velocity_x * a$velocity_y +
      sl_y1 * (
        aht * (sl_y1 - a$velocity_y) / (sl_y1 - slr_y1) * slr_y1 +
          aht * (sl_y1 - a$velocity_y) / (sl_y1 - slr_y1) * a$velocity_x -
          aht * a$velocity_y - aht * a$velocity_x
      )
  } else {
    Fy1  <- e$velocity_y * ehd +
      sr_y1 * (ehd * (sr_y1 - e$velocity_y) / (sr_y1 - slr_y1) - ehd)
    Gfy1 <- ehd * e$velocity_y^2 + 0.5 * g * ehd^2 +
      ehd * e$velocity_x * e$velocity_y +
      sr_y1 * (
        ehd * (sr_y1 - e$velocity_y) / (sr_y1 - slr_y1) * slr_y1 +
          ehd * (sr_y1 - e$velocity_y) / (sr_y1 - slr_y1) * e$velocity_x -
          ehd * e$velocity_y - ehd * e$velocity_x
      )
  }

  # --- 下边界 ---
  sl_y2 <- min(c$velocity_y - sqrt(g * cht), a$velocity_y - sqrt(g * ahd))
  sr_y2 <- max(c$velocity_y + sqrt(g * cht), a$velocity_y + sqrt(g * ahd))
  slr_y2 <- ifelse(
    is.na((ahd * a$velocity_y * (sr_y2 - a$velocity_y) -
             cht * c$velocity_y * (sl_y2 - c$velocity_y) +
             0.5 * g * (cht^2 - ahd^2)) /
            (ahd * (sr_y2 - a$velocity_y) -
               cht * (sl_y2 - c$velocity_y))) |
      is.infinite((ahd * a$velocity_y * (sr_y2 - a$velocity_y) -
                     cht * c$velocity_y * (sl_y2 - c$velocity_y) +
                     0.5 * g * (cht^2 - ahd^2)) /
                    (ahd * (sr_y2 - a$velocity_y) -
                       cht * (sl_y2 - c$velocity_y))),
    0,
    (ahd * a$velocity_y * (sr_y2 - a$velocity_y) -
       cht * c$velocity_y * (sl_y2 - c$velocity_y) +
       0.5 * g * (cht^2 - ahd^2)) /
      (ahd * (sr_y2 - a$velocity_y) -
         cht * (sl_y2 - c$velocity_y))
  )

  if (sl_y2 >= 0) {
    Fy2  <- c$velocity_y * cht
    Gfy2 <- cht * c$velocity_y^2 + 0.5 * g * cht^2 +
      cht * c$velocity_x * c$velocity_y
  } else if (sr_y2 <= 0) {
    Fy2  <- a$velocity_y * ahd
    Gfy2 <- ahd * a$velocity_y^2 + 0.5 * g * ahd^2 +
      ahd * a$velocity_x * a$velocity_y
  } else if (sl_y2 <= 0 && slr_y2 >= 0) {
    Fy2  <- c$velocity_y * cht +
      sl_y2 * (cht * (sl_y2 - c$velocity_y) / (sl_y2 - slr_y2) - cht)
    Gfy2 <- cht * c$velocity_y^2 + 0.5 * g * cht^2 +
      cht * c$velocity_x * c$velocity_y +
      sl_y2 * (
        cht * (sl_y2 - c$velocity_y) / (sl_y2 - slr_y2) * slr_y2 +
          cht * (sl_y2 - c$velocity_y) / (sl_y2 - slr_y2) * c$velocity_x -
          cht * c$velocity_y - cht * c$velocity_x
      )
  } else {
    Fy2  <- a$velocity_y * ahd +
      sr_y2 * (ahd * (sr_y2 - a$velocity_y) / (sr_y2 - slr_y2) - ahd)
    Gfy2 <- ahd * a$velocity_y^2 + 0.5 * g * ahd^2 +
      ahd * a$velocity_x * a$velocity_y +
      sr_y2 * (
        ahd * (sr_y2 - a$velocity_y) / (sr_y2 - slr_y2) * slr_y2 +
          ahd * (sr_y2 - a$velocity_y) / (sr_y2 - slr_y2) * a$velocity_x -
          ahd * a$velocity_y - ahd * a$velocity_x
      )
  }

  # ============ 3. 床坡源项离散 ============
  # 右界面
  if (b$water_depth <= 1e-10) {
    gb_x1 <- max(0, gf_x1 - a$dem - a$water_depth)
  } else {
    gb_x1 <- max(0, min(ddem_x1, gf_x1 - a$dem + a$water_depth))
  }
  gfk_x1 <- gf_x1 - gb_x1
  sb_x1 <- (0.5 * g * (a$water_depth + ahl) * (a$dem - gfk_x1)) / dx

  # 左界面
  if (d$water_depth <= 1e-10) {
    gb_x2 <- max(0, gf_x2 - a$dem - a$water_depth)
  } else {
    gb_x2 <- max(0, min(ddem_x2, gf_x2 - a$dem + a$water_depth))
  }
  gfk_x2 <- gf_x2 - gb_x2
  sb_x2 <- (0.5 * g * (a$water_depth + dhl) * (a$dem - gfk_x2)) / dx

  # 上界面
  if (e$water_depth <= 1e-10) {
    gb_y1 <- max(0, gf_y1 - a$dem - a$water_depth)
  } else {
    gb_y1 <- max(0, min(ddem_y1, gf_y1 - a$dem + a$water_depth))
  }
  gfk_y1 <- gf_y1 - gb_y1
  sb_y1 <- (0.5 * g * (a$water_depth + aht) * (a$dem - gfk_y1)) / dy

  # 下界面
  if (c$water_depth <= 1e-10) {
    gb_y2 <- max(0, gf_y2 - a$dem - a$water_depth)
  } else {
    gb_y2 <- max(0, min(ddem_y2, gf_y2 - a$dem + a$water_depth))
  }
  gfk_y2 <- gf_y2 - gb_y2
  sb_y2 <- (0.5 * g * (a$water_depth + cht) * (a$dem - gfk_y2)) / dy

  # 合并
  sbx <- sb_x1 - sb_x2
  sby <- sb_y1 - sb_y2

  # ============ 4. 摩擦项离散 ============
  mx <- a$water_depth * a$velocity_x + dt * (sbx - (Gfx1 - Gfx2) / dx)
  my <- a$water_depth * a$velocity_y + dt * (sby - (Gfy1 - Gfy2) / dy)
  ds <- dt * g * n^2 * a$water_depth^(-4 / 3) *
    sqrt((mx / a$water_depth)^2 + (my / a$water_depth)^2)

  if (ds < 1e-10) {
    qx <- mx
    qy <- my
  } else {
    qx <- (mx - mx * sqrt(1 + 4 * ds)) / (-2 * ds)
    qy <- (my - my * sqrt(1 + 4 * ds)) / (-2 * ds)
  }

  # ============ 5. 最终更新 ============
  water_depth_new <- a$water_depth +
    dt * (a$r - a$i - a$drainage) -
    dt * ((Fx1 - Fx2 + Fy1 - Fy2) / dy)

  water_depth_new <- ifelse(water_depth_new < 0, h_min, water_depth_new)

  # qx <- pmin(pmax(qx, -10 * water_depth_new), 10 * water_depth_new)
  # qy <- pmin(pmax(qy, -10 * water_depth_new), 10 * water_depth_new)

  velocity_x_new <- ifelse(water_depth_new == h_min, 0, qx / water_depth_new)
  velocity_y_new <- ifelse(water_depth_new == h_min, 0, qy / water_depth_new)

  velocity_x_new <- ifelse(
    abs(velocity_x_new) > 10,
    sign(velocity_x_new) * 10,
    velocity_x_new
  )
  velocity_y_new <- ifelse(
    abs(velocity_y_new) > 10,
    sign(velocity_y_new) * 10,
    velocity_y_new
  )

  # ============ 6. 更新状态并清理外部输入 ============
  a$water_depth <- water_depth_new
  a$velocity_x <- velocity_x_new
  a$velocity_y <- velocity_y_new
  a$r <- NULL
  a$i <- NULL
  a <- a[, c("grid_cell_id", "water_depth", "velocity_x", "velocity_y")]

  return(a)
}
